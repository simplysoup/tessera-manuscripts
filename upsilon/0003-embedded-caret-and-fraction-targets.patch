 void
+edit_interface_rep::empty_fraction_targets (path* slots, rectangle* bounds) {
+  static const bool tessera_editor= get_env ("TEXMACS_TESSERA_EDITOR") == "1";
+  if (!tessera_editor || !got_focus || full_screen || is_nil (eb)) return;
+
+  // Offer targets for the innermost fraction containing the caret.
+  for (path p= path_up (tp); rp <= p; p= path_up (p)) {
+    tree t= subtree (et, p);
+    if (is_compound (t) && N(t) == 2 &&
+        (is_func (t, FRAC) || is_compound (t, "tfrac") ||
+         is_compound (t, "dfrac") || is_compound (t, "frac*") ||
+         is_compound (t, "cfrac"))) {
+      if (t[0] != "" && t[1] != "") return;
+      cursor num= eb->find_check_cursor (start (et, p * 0));
+      cursor den= eb->find_check_cursor (start (et, p * 1));
+      if (!num->valid || !den->valid) return;
+      SI split= (num->oy + num->y1 + den->oy + den->y2) / 2;
+      SI half_width= 8 * zpixel;
+      for (int i= 0; i < 2; i++) {
+        if (t[i] != "") continue;
+        cursor c= i == 0 ? num : den;
+        SI bottom= c->oy + c->y1 - 2*zpixel;
+        SI top= c->oy + c->y2 + 2*zpixel;
+        if (i == 0) bottom= max (bottom, split + zpixel);
+        else top= min (top, split - zpixel);
+        if (bottom >= top) continue;
+        bounds[i]= rectangle (c->ox - half_width, bottom,
+                              c->ox + half_width, top);
+        slots[i]= p * i * 0;
+      }
+      return;
+    }
+    if (p == rp) break;
+  }
+}
