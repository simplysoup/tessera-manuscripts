@@ -174,4 +174,14 @@
     ENV['TEXMACS_TESSERA_EDITOR'] = '1';
     FS.mkdirTree ('/home/web/.TeXmacs');
+    // Keep the compiled font and file cache between editor iframes without
+    // persisting the embedded editor's preferences or working documents.
+    var cachePath = '/home/web/.TeXmacs/system/cache';
+    FS.mkdirTree (cachePath);
+    FS.mount (IDBFS, { autoPersist: true }, cachePath);
+    addRunDependency ('tm-embedded-font-cache');
+    FS.syncfs (true, function (err) {
+      if (err) console.error ('TeXmacs: cannot read the saved font cache', err);
+      removeRunDependency ('tm-embedded-font-cache');
